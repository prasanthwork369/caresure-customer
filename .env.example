# Copy this file to .env.local (gitignored) and adjust if needed.
# EXPO_PUBLIC_* is inlined into the JS bundle at build time — no secrets here.

# Backend API base URL (see src/api/config.ts / app.config.ts)
EXPO_PUBLIC_API_BASE_URL=https://qa-csapi.codeneptune.com

# Public web store origin, used for Terms/Privacy/Refund links (see src/constants/urls.ts)
EXPO_PUBLIC_WEB_BASE_URL=https://caresure.com
